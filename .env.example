APP_ENV=development
REDIS_URL=redis://127.0.0.1:16379/
DATABASE_URL=postgres://message_lab:dev_password@127.0.0.1:65432/message_lab

# Optional worker settings
# CONSUMER_NAME=redis-worker-local
MAX_IN_FLIGHT=10
MIN_IDLE_MS=60000
RECOVERY_INTERVAL_SECS=5
FAIL_BEFORE_ACK=false

RUST_LOG=info

# Retry and dead-letter policy.
# retry_count is an application retry counter; Redis PEL delivery count is separate.
MAX_RETRIES=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
RETRY_ZSET=orders:{events}:retry
RETRY_PAYLOADS=orders:{events}:retry:payloads
RETRY_SCHEDULER_INTERVAL_MS=1000
RETRY_SCHEDULER_BATCH_SIZE=100
DLQ_STREAM=orders:{events}:dead
DLQ_INDEX=orders:{events}:dead:index
